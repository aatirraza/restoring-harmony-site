# Copy this file to .env and fill it in. Never commit .env.

# --- Server ---
PORT=3001
# Required in production: a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# How long an admin stays signed in, in hours.
SESSION_HOURS=12
# Number of proxies in front of the app (1 on most cPanel / nginx setups, 0 when running directly).
TRUST_PROXY=0
# Serve the built site from dist/ as well as the API (set to false if the site is hosted elsewhere).
SERVE_STATIC=true

# --- Database ---
# sqlite (local development, no install needed), mysql, or postgres
DB_CLIENT=sqlite
SQLITE_FILE=data/dev.sqlite

# For mysql or postgres, either a single URL:
# DATABASE_URL=postgres://user:password@host:5432/restoring_harmony
# ...or separate fields:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=
# DB_PASSWORD=
# DB_NAME=restoring_harmony
# DB_SSL=false

# --- Front end (build time) ---
# Only needed if the API runs on a different domain from the site.
# VITE_API_URL=https://api.example.com
